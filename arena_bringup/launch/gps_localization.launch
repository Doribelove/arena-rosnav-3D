<launch>
  <arg name="port" default="/dev/ttyUSB1"/>
  <arg name="baud_rate" default="115200"/>
  <arg name="map_frame" default="camera_init"/>
  <arg name="odom_frame" default="odom"/>
  <arg name="base_frame" default="base_link"/>
  <arg name="origin_lat" default=""/>
  <arg name="origin_lon" default=""/>

  <node pkg="arena_bringup" type="gps_localization_node.py" name="gps_localization" output="screen">
    <param name="port" value="$(arg port)"/>
    <param name="baud_rate" value="$(arg baud_rate)"/>
    <param name="map_frame" value="$(arg map_frame)"/>
    <param name="odom_frame" value="$(arg odom_frame)"/>
    <param name="base_frame" value="$(arg base_frame)"/>
    <param name="pose_topic" value="/gps/pose"/>
    <param name="odom_topic" value="/gps/odom"/>
    <param name="fix_topic" value="/gps/fix"/>
    <param name="publish_rate" value="10.0"/>
    <param name="broadcast_tf" value="true"/>
    <param name="origin_lat" value="$(arg origin_lat)" unless="$(eval arg('origin_lat') == '')"/>
    <param name="origin_lon" value="$(arg origin_lon)" unless="$(eval arg('origin_lon') == '')"/>
  </node>
</launch>
